<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% capture resource_title %}{{ title | strip_html | strip_newlines }}{% endcapture %}
{%- if resource_title != "Index" and resource_title != "" -%}
  {%- capture page_title -%}{{ resource_title }} | {{ metadata.title }}{%- endcapture -%}
  {%- assign share_title = resource_title -%}
{%- else -%}
  {%- capture page_title -%}{{ metadata.title }}: {{ metadata.tagline }}{%- endcapture -%}
  {%- assign share_title = metadata.title -%}
{%- endif -%}
{%- assign page_description = description | default: metadata.description | strip_html | strip_newlines | strip -%}
{%- assign page_url = url | default: "/" | absolute_url -%}
{%- assign share_image_path = "/images/og-default.jpg" -%}
{%- if type == "post" -%}
  {%- if image -%}
    {%- assign share_image_path = image -%}
  {%- elsif og_cards[slug] -%}
    {%- assign share_image_path = "/images/og/" | append: slug | append: ".png" -%}
  {%- endif -%}
{%- endif -%}
{%- assign share_image = share_image_path | absolute_url -%}
<title>{{ page_title | escape }}</title>

<meta name="description" content="{{ page_description | escape }}" />
<link rel="canonical" href="{{ page_url }}" />

<meta property="og:site_name" content="{{ metadata.title | escape }}" />
<meta property="og:type" content="{% if type == 'post' %}article{% else %}website{% endif %}" />
<meta property="og:title" content="{{ share_title | escape }}" />
<meta property="og:description" content="{{ page_description | escape }}" />
<meta property="og:url" content="{{ page_url }}" />
<meta property="og:image" content="{{ share_image }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ share_title | escape }}" />
<meta name="twitter:description" content="{{ page_description | escape }}" />
<meta name="twitter:image" content="{{ share_image }}" />

<link rel="stylesheet" href="{% asset_path css %}" />
<script src="{% asset_path js %}" defer></script>
{% live_reload_dev_js %}
